# Copy to .env for local development, .env.prod for deployment
# Every value below is a Settings default except POSTGRES_PASSWORD

# App Config
APP_PROJECT_NAME=JYYFinHub Spend Tracker
APP_DEBUG=true
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_LOG_LEVEL=INFO
# only used by compose.prod.yml
APP_HOST=127.0.0.1
APP_PORT=8000

# DB Config
POSTGRES_USER=spendtracker
POSTGRES_PASSWORD=
POSTGRES_DB=spendtracker
# 127.0.0.1 because uvicorn runs on the host and reaches the db through the published port
POSTGRES_HOST=127.0.0.1
# host port only, the container always listens on 5432
POSTGRES_PORT=5432

# SQLAlchemy Config
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
